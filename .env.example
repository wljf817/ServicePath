OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_MODE=responses
OPENAI_MODEL=gpt-5.6
# Fixed server endpoint used only when this instance runs as a client.
REMOTE_SERVICE_URL=
SERVICEPATH_API_TOKEN=
SETTINGS_PASSWORD=
SERVICEPATH_DEBUG=

# Docker publishes to loopback by default. Change this only when intentional.
SERVICEPATH_BIND_ADDRESS=127.0.0.1
SERVICEPATH_PORT=5050
